# Regras locais do laboratório Edge Security.
# Disparam apenas com os marcadores gerados por lab/traffic.sh; não detectam ameaças reais.
alert dns any any -> any any (msg:"EDGE-LAB consulta DNS ao marcador lab-alerta.test"; dns.query; content:"lab-alerta.test"; nocase; classtype:misc-activity; priority:3; sid:9000001; rev:1;)
alert http any any -> any any (msg:"EDGE-LAB requisicao HTTP ao marcador /lab-marker"; flow:established,to_server; http.uri; content:"/lab-marker"; classtype:misc-activity; priority:2; sid:9000002; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET [21,23,3389] (msg:"EDGE-LAB tentativa de conexao a porta sensivel"; flow:to_server; flags:S; classtype:attempted-recon; priority:1; sid:9000003; rev:1;)
